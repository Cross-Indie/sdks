{
  "name": "@crossindie/react-native",
  "version": "1.0.0",
  "description": "Free cross-promotion banner for indie React Native and Expo apps (CrossIndie network). Pure JS, no native modules.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "crossindie",
    "react-native",
    "expo",
    "cross-promotion",
    "banner",
    "indie"
  ],
  "homepage": "https://crossindie.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cross-Indie/sdks.git",
    "directory": "react-native"
  },
  "bugs": "https://github.com/Cross-Indie/sdks/issues",
  "license": "MIT",
  "sideEffects": false,
  "peerDependencies": {
    "expo-application": "*",
    "react": ">=17",
    "react-native": ">=0.64"
  },
  "peerDependenciesMeta": {
    "expo-application": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "ts-jest": "^29.2.5",
    "typescript": "~5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
